# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/liftdiary?sslmode=require"

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: enables importing a workout split from a screenshot (OpenAI vision).
# The app works fine without it; the import step is simply unavailable.
OPENAI_API_KEY=""
# OPENAI_VISION_MODEL="gpt-4.1-mini"
